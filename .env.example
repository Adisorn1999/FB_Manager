# Copy this file to .env on the server and replace every value before deploying.

REACT_APP_API_URL=https://api.yourdomain.com
CLIENT_URL=https://yourdomain.com

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=fb_manager
MYSQL_USER=fbmanager
MYSQL_PASSWORD=replace-with-a-strong-database-password

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
APP_CRYPTO_SECRET=replace-with-a-different-long-random-secret-at-least-32-chars
