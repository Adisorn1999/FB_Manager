# =========================
# SERVER
# =========================
PORT=5000
NODE_ENV=development

# =========================
# DATABASE
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=fb_manager

# =========================
# SECURITY
# =========================
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
APP_CRYPTO_SECRET=replace-with-a-different-long-random-secret-at-least-32-chars

# =========================
# OPTIONAL LOGIN LIMIT
# =========================
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=10

# =========================
# CLIENT
# =========================
CLIENT_URL=http://localhost:3000